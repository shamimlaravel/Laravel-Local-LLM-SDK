{
    "preset": "laravel",
    "rules": {
        "align_multiline_comment": true,
        "array_indentation": true,
        "array_syntax": "short",
        "blank_line_after_namespace": true,
        "blank_line_after_opening_tag": false,
        "blank_line_before_return": true,
        "braces": {
            "allow_single_line_anonymous_class": false,
            "allow_single_line_closure": false
        },
        "cast_spaces": {
            "space": "none"
        },
        "class_attributes_separation": {
            "elements": {
                "const": "one",
                "method": "one",
                "property": "one",
                "trait_use": "one"
            }
        },
        "class_definition": {
            "single_line": false,
            " multiline": {
                "elements": ["body"]
            }
        },
        "combine_consecutive_issets": true,
        "combine_consecutive_unsets": true,
        "comment_to_phpdoc": {
            "ignored_comments": []
        },
        "compact_nullable_typehint": true,
        "concat_space": {
            "spacing": "one"
        },
        "constant_case": {
            "case": "lower"
        },
        "control_structure_braces": true,
        "control_structure_continuation_position": {
            "position": "same"
        },
        "curly_braces_position": {
            "allow_single_line_anonymous_class": false,
            "allow_single_line_closure": false,
            "classes_opening_brace": "next_line_unless_newline_at_class_end",
            "functions_opening_brace": "next_line_unless_newline_at_function_end",
            "anonymous_classes_opening_brace": "next_line_unless_newline_at_class_end",
            "anonymous_functions_opening_brace": "next_line_unless_newline_at_function_end",
            "control_structures_opening_brace": "same_line",
            "control_structures_closing_brace": "next_line_unless_open_brace_is_last_token"
        },
        "declare_equal_normalize": {
            "space": "none"
        },
        "dir_constant": true,
        "doctrine_annotation_braces": false,
        "doctrine_annotation_indentation": false,
        "doctrine_annotation_spaces": {
            "after_argument_assignment_space": "none",
            "after_array_assignments_space": "none",
            "before_argument_assignment_space": "none",
            "before_array_assignments_space": "none"
        },
        "elseif": {
            "position": "next_line"
        },
        "empty_loop_body": {
            "style": "braces"
        },
        "empty_loop_condition": {
            "style": "while"
        },
        "encoding": true,
        "ereg_to_preg": true,
        "error_suppression": {
            "mute_deprecation_error": false,
            "optimize_autoloader": true,
            "remove_deprecation_errors": false,
            "remove_unused_variable_errors": false
        },
        "escape_implicit_backslashes": {
            "double_quoted": true,
            "heredoc_syntax": true,
            "single_quoted": false
        },
        "explicit_indirect_variable": true,
        "explicit_string_variable": true,
        "final_class": false,
        "final_internal_class": false,
        "final_public_method_visibility": false,
        "fopen_flags": false,
        "full_opening_tag": true,
        "fully_qualified_strict_types": {
            "include_implements": false,
            "include_phpdoc_tags": true
        },
        "function_declaration": {
            "closure_function_spacing": "one"
        },
        "function_to_constant": {
            "functions": [
                "get_class",
                "get_called_class",
                "php_sapi_name",
                "gettype",
                "function_exists",
                "class_exists",
                "interface_exists",
                "trait_exists"
            ]
        },
        "general_phpdoc_tag_rename": {
            "case_precision": "unchanged",
            "fix_annotation": false,
            "fix_inline_tag": true,
            "replacements": [
                "inheritDoc": "inheritdoc"
            ]
        },
        "global_namespace_import": {
            "import_classes": true,
            "import_constants": false,
            "import_functions": false
        },
        "header_comment": {
            "comment_type": "PHPDoc",
            "header": "",
            "location": "after_declare_strict",
            "separate": "none"
        },
        "heredoc_to_nowdoc": true,
        "include": true,
        "increment_style": {
            "style": "pre"
        },
        "indentation_type": true,
        "is_null": {
            "use_yoda_style": false
        },
        "lambda_not_used_import": true,
        "line_ending": true,
        "linebreak_after_opening_tag": false,
        "list_syntax": "short",
        "lowercase_cast": true,
        "lowercase_class_reference": false,
        "lowercase_constants": true,
        "lowercase_keywords": true,
        "lowercase_static_reference": true,
        "magic_constant_casing": true,
        "magic_method_casing": true,
        "method_argument_space": {
            "on_multiline": "ensure_fully_multiline",
            "keep_multiple_spaces_after_comma": true
        },
        "method_chaining_indentation": true,
        "modernize_strpos": true,
        "multiline_comment_opening_closing": true,
        "multiline_whitespace_before_semicolons": {
            "strategy": "no_multiline"
        },
        "native_constant_casing": true,
        "native_function_casing": true,
        "native_function_invocation": {
            "include": [
                "Composer\\Autoload\\ComposerStaticInit*",
                "Symfony\\Component\\VarDumper\\VarDumper"
            ],
            "exclude": []
        },
        "new_with_parentheses": {
            "anonymous_class": false,
            "named_class": false
        },
        "no_alternative_syntax": true,
        "no_binary_string": true,
        "no_blank_lines_after_class_opening": true,
        "no_blank_lines_after_phpdoc": true,
        "no_blank_lines_before_namespace": false,
        "no_break_comment": true,
        "no_closing_tag": true,
        "no_comments_as_location": true,
        "no_empty_comment": true,
        "no_empty_phpdoc": true,
        "no_empty_statement": true,
        "no_extra_blank_lines": {
            "tokens": [
                "attribute",
                "case",
                "continue",
                "curly_brace_block",
                "default",
                "extra",
                "parenthesis_brace_block",
                "square_brace_block",
                "switch",
                "throw",
                "use",
                "use_trait"
            ]
        },
        "no_homoglyph_names": true,
        "no_leading_import_slash": true,
        "no_leading_namespace_declaration": true,
        "no_mixed_echo_print": {
            "use": "echo"
        },
        "no_multiline_whitespace_around_double_arrow": true,
        "no_multiple_cron_schedule": true,
        "no_null_property_initialization": true,
        "no_php4_constructor": true,
        "no_short_bool_cast": true,
        "no_singleline_var_schema": true,
        "no_space_after_double_colon": true,
        "no_space_around_double_colon": false,
        "no_space_before_method_arg": false,
        "no_trailing_comma_in_list_call": true,
        "no_trailing_comma_in_singleline_array": true,
        "no_unneeded_control_parentheses": {
            "break",
            "continue",
            "return",
            "yield",
            "yield_from"
        },
        "no_unneeded_final_method": false,
        "no_unreachable_default_argument_value": true,
        "no_useless_concat_operator": true,
        "no_useless_else": true,
        "no_useless_nullsafe_operator": true,
        "no_whitespace_before_comma_in_array": true,
        "no_whitespace_in_blank_line": true,
        "non_printable_character": {
            "use_escape_sequences_in_strings": true
        },
        "normalize_index_brace": true,
        "not_operator_with_space": false,
        "not_operator_with_successor_space": false,
        "nullable_type_declaration": {
            "use_nullable_type_declaration": true,
            "force_nullable_type_declaration": false
        },
        "nullable_type_declaration_for_default_null_value": {
            "use_nullable_type_declaration": true,
            "force_use_nullable_type_declaration": false
        },
        "object_operator_without_whitespace": true,
        "octal_notation": true,
        "operator_linebreak": {
            "only_if_end_tag_line_break": false,
            "position": "end"
        },
        "ordered_class_elements": {
            "order": [
                "use_trait",
                "case",
                "constant_public",
                "constant_protected",
                "constant_private",
                "property_public",
                "property_protected",
                "property_private",
                "construct",
                "destruct",
                "magic",
                "method_public",
                "method_protected",
                "method_private"
            ]
        },
        "ordered_imports": {
            "imports_order": [
                "class",
                "function",
                "const"
            ],
            "sort_algorithm": "alpha"
        },
        "ordered_interfaces": true,
        "ordered_traits": true,
        "package_version": false,
        "parallel_api_usage": {
            "function_whitelist": [
                "proc_open",
                "shell_exec",
                "exec"
            ]
        },
        "php_unit_dedicate_assert": {
            "target": "newest"
        },
        "php_unit_dedicate_assert_internal_type": {
            "target": "newest"
        },
        "php_unit_expectation": {
            "target": "newest"
        },
        "php_unit_fqcn_annotation": false,
        "php_unit_internal_class": false,
        "php_unit_method_casing": {
            "case": "snake_case"
        },
        "php_unit_mock": {
            "target": "newest"
        },
        "php_unit_namespaced": {
            "target": "newest"
        },
        "php_unit_no_expectation_annotation": {
            "target": "newest",
            "use_class_const": true
        },
        "php_unit_ordered_class": false,
        "php_unit_set_up_tear_down_visibility": false,
        "php_unit_strict": false,
        "php_unit_test_annotation": {
            "target": "newest"
        },
        "php_unit_test_case_static_method_calls": {
            "call_type": "this"
        },
        "php_unit_verifies_resource": false,
        "phpdoc": {
            "adapter_class": false,
            "alignment": true,
            "api": false,
            "const": false,
            "empty_tags": false,
            "exclude_throws": false,
            "no_empty_after_return": false,
            "no_index": false,
            "no_inheritdoc": false,
            "inline_no_empty_doc_errors": false,
            "line_ending": " ",
            "lowercase_first": false,
            "marker_re Hilit": "o",
            "multiline_blocks": true,
            "no_access_tags": false,
            "no_alias_tags": [],
            "no_empty_tags": false,
            "normalize": "abc",
            "order": [
                "param",
                "throws",
                "return"
            ],
            "param": true,
            "property": false,
            "protected_to_public": false,
            "public_to_public": false,
            "readonly": false,
            "return": true,
            "separate": "none",
            "short_description": false,
            "tags_order": [
                "param",
                "return",
                "throws"
            ],
            "throw": true,
            "to_do": false,
            "type": false,
            "uses_throws": false,
            "var": false
        },
        "phpdoc_align": {
            "align": "left",
            "tags": [
                "param",
                "property",
                "return",
                "throws",
                "type",
                "var"
            ]
        },
        "phpdoc_annotation_without_dot": false,
        "phpdoc_indent": true,
        "phpdoc_inline_tag_normalizer": true,
        "phpdoc_no_access": true,
        "phpdoc_no_alias_tag": false,
        "phpdoc_no_empty_return": false,
        "phpdoc_no_package": false,
        "phpdoc_no_useless_inheritdoc": true,
        "phpdoc_order": {
            "order": [
                "param",
                "return",
                "throws"
            ]
        },
        "phpdoc_return_self_reference": {
            "replacements": [
                "this": "$this",
                "@this": "$this",
                "static": "$this",
                "@static": "$this",
                "parent": "$this",
                "@parent": "$this"
            ]
        },
        "phpdoc_scalar": true,
        "phpdoc_separation": {
            "groups": [
                [
                    "param",
                    "return"
                ],
                [
                    "throws"
                ],
                [
                    "deprecated"
                ]
            ]
        },
        "phpdoc_single_line_var_shorts": true,
        "phpdoc_to_comment": false,
        "phpdoc_to_param_type": true,
        "phpdoc_to_property_type": true,
        "phpdoc_to_return_type": true,
        "phpdoc_trim": true,
        "phpdoc_trim_consecutive_blank_line_separation": true,
        "phpdoc_types": {
            "groups": true
        },
        "phpdoc_types_order": {
            "case_first": "lower"
        },
        "phpdoc_var_annotation_correct_order": true,
        "phpdoc_var_without_name": true,
        "pow_to_exponentiation": true,
        "prefer_escape_string": {
            "escape_sequences": "octal"
        },
        "protected_to_private": false,
        "psr_autoloading": {
            "dir": "src"
        },
        "random_api_migration": {
            "functions": [
                "random_bytes",
                "random_int"
            ]
        },
        "regular_callable_call": true,
        "return_type_declaration": {
            "space_before": "none"
        },
        "self_accessor": false,
        "self_static_accessor": true,
        "semicolon_after_instruction": true,
        "set_type_to_cast": false,
        "short_scalar_cast": true,
        "simplified_null_return": false,
        "single_class_element_per_statement": {
            "elements": [
                "const",
                "property"
            ]
        },
        "single_import_per_line": false,
        "single_line_after_imports": true,
        "single_line_comment_style": {
            "allowed_styles": [
                "asterisk",
                "double_slash"
            ],
            "comment_decoration": "",
            "force_after_header": false,
            "indicators": [
                "!"
            ]
        },
        "single_quote": {
            "strings_containing_single_quote_chars": false
        },
        "space_after_semicolon": {
            "remove_in_empty_for_expressions": false
        },
        "standardize_not_equals": true,
        "static_lambda": true,
        "strict_comparison": true,
        "strict_param": true,
        "string_length_to_empty": true,
        "string_to_url": {
            "components": 0,
            "exclude": []
        },
        "switch_case_colon": true,
        "switch_case_ellipsis": true,
        "switch_case_space": true,
        "ternary_operator_spaces": true,
        "ternary_to_null_coalescing": true,
        "trailing_comma_in_multiline": {
            "after_heredoc": false,
            "elements": [
                "arrays",
                "parameters"
            ]
        },
        "trim_array_spaces": true,
        "types_spaces": {
            "space": "none"
        },
        "unary_operator_spaces": true,
        "use_arrow_functions": false,
        "visibility_required": {
            "elements": [
                "const",
                "method",
                "property"
            ]
        },
        "void_return": true,
        "whitespace_after_comma_in_array": true,
        "yoda_style": {
            "always_move_variable": false,
            "equal": false,
            "identical": false,
            "less_and_greater": false
        }
    },
    "exclude": [
        "vendor",
        "node_modules",
        "storage",
        "bootstrap/cache",
        "resources",
        "tests"
    ]
}
